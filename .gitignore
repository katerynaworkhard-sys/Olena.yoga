# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local SQLite databases (schema + migrations are tracked instead)
prisma/dev.db
*.db-journal
*.db-wal
*.db-shm

# Claude Code tooling (local worktrees, hooks, etc.)
.claude/

# Raw source media kept locally — optimized web versions live in public/
/video*.mov
/video*.MP4
/a_*.jpeg
/b_*.jpeg
/photo*.jpg
/photo*.jpeg
/certificate.png

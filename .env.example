# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# Database URL. SQLite for local dev. For production, point to a hosted DB.
DATABASE_URL=file:./prisma/dev.db

# Admin login password. Use a strong, unique value in production.
ADMIN_PASSWORD=change-me

# Random secret used to sign admin session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string
